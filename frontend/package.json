{
  "name": "inventory-art-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "pwa:assets": "pwa-assets-generator --preset minimal-2023 --root public --html=false --manifest=false logo.png",
    "pwa:check": "node scripts/check-pwa-build.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . \"../README.md\" \"../AGENTS.md\" \"../docs/**/*.md\" \"../*.{json,yml,yaml}\" \"../.github/**/*.{yml,yaml}\" \"../.agents/skills/**/*.{md,yml,yaml}\" \"../backend/src/main/resources/**/*.{json,yml,yaml}\"",
    "format:check": "prettier --check . \"../README.md\" \"../AGENTS.md\" \"../docs/**/*.md\" \"../*.{json,yml,yaml}\" \"../.github/**/*.{yml,yaml}\" \"../.agents/skills/**/*.{md,yml,yaml}\" \"../backend/src/main/resources/**/*.{json,yml,yaml}\"",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "pinia": "^3.0.4",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
